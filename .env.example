# ─── OIDC (Frontend + Backend) ───
OIDC_AUTHORITY=https://idp.example.com/realms/my-cookbook
OIDC_CLIENT_ID=my-cookbook-spa

# ─── Erster Admin (optional, E-Mail muss im Token verifiziert sein) ───
# ADMIN_EMAIL=admin@example.com

# ─── Database ───
DB_NAME=cookbook
DB_USER=cookbook
# Pflicht, kein Default: ohne Wert starten DB und Backend nicht.
# Langes Zufallspasswort; Sonderzeichen erlaubt. Den Wert in einfache
# Anführungszeichen setzen, sonst wertet Compose ein `$` als Variable aus.
DB_PASSWORD=

# ─── OpenAI (optional — AI recipe import disabled if empty) ───
OPENAI_API_KEY=sk-...

# ─── CORS ───
CORS_ORIGINS=["http://localhost:8080"]
