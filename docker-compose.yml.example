services:
  frontend:
    # Images baut die CI (main); Rollback mit IMAGE_TAG=<sha>, lokal bauen: docker-compose.build.yml
    image: ghcr.io/cehser/my-cookbook-frontend:${IMAGE_TAG:-main}
    ports:
      - "8080:80"
    container_name: my-cookbook-frontend
    env_file:
      - .env
    depends_on:
      - backend
    restart: unless-stopped

  backend:
    image: ghcr.io/cehser/my-cookbook-backend:${IMAGE_TAG:-main}
    container_name: my-cookbook-backend
    env_file:
      - .env
    environment:
      - DB_HOST=db
      - DB_PORT=5432
      - UPLOAD_DIR=/app/uploads
      - MAX_UPLOAD_SIZE_MB=5
    volumes:
      - recipe_uploads:/app/uploads
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  db:
    image: postgres:16-alpine
    container_name: my-cookbook-db
    environment:
      - POSTGRES_DB=${DB_NAME:-cookbook}
      - POSTGRES_USER=${DB_USER:-cookbook}
      - POSTGRES_PASSWORD=${DB_PASSWORD:?DB_PASSWORD in .env setzen}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped

volumes:
  pgdata:
  recipe_uploads:
